{
  "name": "@mwpryer/insomniac",
  "version": "0.2.0",
  "description": "A runner that takes coding agents through a plan, one task per session",
  "license": "MIT",
  "author": "mwpryer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwpryer/insomniac.git"
  },
  "bin": {
    "insomniac": "dist/insomniac.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile=dist/insomniac.js",
    "check": "bun run lint && bun run fmt:check && bun run typecheck",
    "fix": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
