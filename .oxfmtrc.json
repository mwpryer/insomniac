{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      {
        "newlinesBetween": true
      },
      "internal",
      "parent",
      "sibling",
      "index"
    ],
    "newlinesBetween": false
  },
  "sortPackageJson": {
    "sortScripts": true
  }
}
